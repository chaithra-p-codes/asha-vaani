# Copy to backend/.env (scripts/setup/generate_keys.py does this for you).
# NEVER commit backend/.env. It is listed in .gitignore.

# ---- Gnani API Platform (required for the live voice loop) ----
GNANI_API_KEY=
# Secondary key: used ONLY if organisers explicitly allow it AND the flag below is true.
GNANI_API_KEY_SECONDARY=
GNANI_SECONDARY_AUTHORISED=false
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
# Prisma v3.0 formats: verbatim | transcribe | codemix | transliterate
GNANI_STT_FORMAT=codemix
# Timbre v3.0 voice (catalog: docs.gnani.ai/api/TTS/available-voices). Chetana = warm, healthcare.
GNANI_TTS_VOICE=Chetana
GNANI_TTS_SPEED=1.0
GNANI_TTS_SAMPLE_RATE=24000
GNANI_STT_VAD_THRESHOLD=0.5
GNANI_STT_MIN_SILENCE_MS=600

# ---- Optional LLM extraction (open choice). Leave empty for rule-based extraction only. ----
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=2.5

# ---- Turn endpointing ----
ENDPOINT_SILENCE_DICTATION_MS=1100
ENDPOINT_SILENCE_SHORT_MS=700
ACK_FILLER=true

# ---- Storage / privacy ----
# 32-byte base64 AES-256-GCM key, kept outside the database. generate_keys.py creates it.
ASHA_DATA_KEY=
RETENTION_HOURS=72
ASHA_ENV=dev
# live = Gnani loop; demo = clearly-labelled sample-note mode (never calls Gnani)
ASHA_SPEECH_MODE=live
ASHA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ASHA_TIMEZONE=Asia/Kolkata
