{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "dist/assets",
    "rootDir": "src",
    "sourceMap": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/**/*.ts"]
}
